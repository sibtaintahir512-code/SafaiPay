# ==============================================================================
# SafaiPay Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS
# DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

PROJECT_NAME=SafaiPay
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Security & JWT Tokens
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Async SQLAlchemy)
# Default for zero-config local testing:
DATABASE_URL=sqlite+aiosqlite:///./safaipay.db
SYNC_DATABASE_URL=sqlite:///./safaipay.db

# Production PostgreSQL Connection Example:
# DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/safaipay_db
# SYNC_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/safaipay_db

# Redis & Cache Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MOCK_FALLBACK=True

# External Service Provider Adapters (Pluggable Architecture)
STORAGE_PROVIDER=local        # Options: local, s3, gcs
MAPS_PROVIDER=osm             # Options: osm, google_maps
AI_PROVIDER=mock              # Options: mock, torch, gemini
PAYMENT_PROVIDER=mock         # Options: mock, raast, jazzcash, easypaisa
EMAIL_PROVIDER=mock           # Options: mock, smtp, sendgrid
SMS_PROVIDER=mock             # Options: mock, twilio, local_gateway
WHATSAPP_PROVIDER=mock        # Options: mock, meta_graph

# Phone / SMS / OTP Service Configuration
OTP_MOCK_MODE=True
OTP_DEFAULT_CODE=123456
OTP_EXPIRATION_SECONDS=300

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","*"]

# Default Initial Superadmin Credentials (for Seed scripts only)
DEFAULT_ADMIN_EMAIL=admin@safaipay.org
DEFAULT_ADMIN_PHONE=+923000000000
DEFAULT_ADMIN_PASSWORD=your_admin_secure_password_here
DEFAULT_DEMO_PASSWORD=your_demo_secure_password_here

# Standard Demo Test Accounts (for local development & evaluation)
DEMO_CUSTOMER_EMAIL=customer@safaipay.test
DEMO_CUSTOMER_PASSWORD=SafaiPassword123!
DEMO_COLLECTOR_EMAIL=collector@safaipay.test
DEMO_COLLECTOR_PASSWORD=SafaiPassword123!
DEMO_RECYCLER_EMAIL=recycler@safaipay.test
DEMO_RECYCLER_PASSWORD=SafaiPassword123!
DEMO_ADMIN_EMAIL=admin@safaipay.test
DEMO_ADMIN_PASSWORD=AdminPassword123!

# Frontend / Next.js Configuration (Optional external backend override)
NEXT_PUBLIC_API_URL=/api/v1
# BACKEND_URL=https://your-api-domain.example.com
