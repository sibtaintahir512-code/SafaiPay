# ==============================================================================
# SafaiPay Staging & Production Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

# Core Application Environment (staging / production / development)
APP_ENV=staging
ENVIRONMENT=staging
LOG_LEVEL=INFO
PROJECT_NAME=SafaiPay
API_V1_PREFIX=/api/v1

# Security & JWT Tokens
# Generate a cryptographically secure 256-bit random key:
#   openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase PostgreSQL / PostGIS Database Connection
# Supported formats: postgresql+asyncpg://, postgresql://, postgres://
#
# Direct Connection (Supabase Standard):
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
#
# Supabase Transaction Pooler (PgBouncer - Port 6543):
#   DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Database Connection Pooling Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_USE_NULL_POOL=false
DB_SSL_MODE=require

# Upstash Redis for Distributed Rate Limiting & Background Tasks (TLS enabled)
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT
REDIS_MOCK_FALLBACK=True
REDIS_FALLBACK_MODE=warning   # Options: warning, fallback, fail_closed

# CORS Allowed Origins (Set to your Vercel staging deployment domain)
CORS_ORIGINS=https://your-vercel-staging-domain.vercel.app

# Payment Gateway Sandbox Mode (Zero real payment keys here)
PAYMENT_MODE=sandbox
PAYMENT_PROVIDER=sandbox      # Options: sandbox, mock, raast, easypaisa, jazzcash
PAYMENT_GATEWAY_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=staging-sandbox-webhook-secret-key-32-chars
RAAST_SANDBOX_MERCHANT_ID=MCH_SANDBOX_001
EASYPAISA_SANDBOX_STORE_ID=STORE_SANDBOX_001

# External Service Provider Adapters (Sandbox Modes)
STORAGE_PROVIDER=local        # Options: local, s3, supabase_storage
MAPS_PROVIDER=osm             # Options: osm, google_maps
AI_PROVIDER=mock              # Options: mock, torch, gemini
EMAIL_PROVIDER=mock           # Options: mock, smtp, sendgrid
SMS_PROVIDER=mock             # Options: mock, twilio, local_gateway
WHATSAPP_PROVIDER=mock        # Options: mock, meta_graph

# Phone / SMS / OTP Service Configuration
OTP_MOCK_MODE=True
OTP_DEFAULT_CODE=123456
OTP_EXPIRATION_SECONDS=300

# Seed Configuration for Staging
# Set to 'true' only if you wish to seed demo user accounts on staging
SEED_DEMO_USERS=false
DEFAULT_ADMIN_EMAIL=admin@safaipay.org
DEFAULT_ADMIN_PHONE=+923000000000
DEFAULT_ADMIN_PASSWORD=replace-with-a-secure-admin-password
DEFAULT_DEMO_PASSWORD=replace-with-a-secure-demo-password

# Frontend Next.js Configuration (Vercel Build Environment)
# In Vercel Project Settings, add these under Environment Variables:
#   NEXT_PUBLIC_API_URL=/api/v1
#   BACKEND_URL=https://your-render-backend-url.onrender.com
NEXT_PUBLIC_API_URL=/api/v1
